{
  "expo": {
    "name": "Affiliate Pulse",
    "slug": "affiliate-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "affiliatepulse",
    "android": {
      "package": "com.nxadx.affiliatepulse",
      "launchMode": "singleTask",
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router"
    ]
  }
}